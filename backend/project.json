{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "backend",
  "targets": {
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./.venv/bin/python -m pip freeze > requirements.txt",
        "cwd": "backend"
      }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.venv"],
      "options": {
        "commands": [
          "python3 -m venv .venv",
          ".venv/bin/pip install --upgrade pip",
          ".venv/bin/pip install -r requirements-dev.txt"
        ],
        "parallel": false,
        "cwd": "backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["orval"],
      "outputs": ["{projectRoot}/__pycache__"],
      "options": {
        "command": "./.venv/bin/python -m compileall .",
        "cwd": "backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "./.venv/bin/python -m uvicorn main:app --reload",
        "cwd": "backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/backend"],
      "options": {
        "command": "pytest",
        "cwd": "backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flake8 .",
        "cwd": "backend"
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}