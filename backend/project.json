{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "backend",
  "sourceRoot": "{projectRoot}",
  "targets": {
    "generate_venv": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/requirements-dev.txt",
        "{projectRoot}/requirements.txt",
        { "env": "PYTHON_VERSION" }
      ],
      "outputs": ["{projectRoot}/.venv"],
      "options": {
        "commands": [
          "python3 -m venv .venv",
          "./.venv/bin/pip install --upgrade pip",
          "./.venv/bin/pip install -r requirements-dev.txt"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "generate_ollama_client": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate_venv"],
      "outputs": ["{projectRoot}/ollama/generated"],
      "options": {
        "commands": [
          "./backend/.venv/bin/openapi-python-client generate --path etc/ollama-service.yaml --output-path backend/ollama/client --overwrite --config ./etc/ollama-client.config",
          "shx rm -rf {projectRoot}/ollama/client/.gitignore",
          "shx rm -rf {projectRoot}/ollama/client/pyproject.toml",
          "shx rm -rf {projectRoot}/ollama/client/REAMDE.md"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate_venv", "generate_ollama_client"],
      "outputs": ["{projectRoot}/__pycache__"],
      "options": {
        "command": "./.venv/bin/python -m compileall .",
        "cwd": "{projectRoot}"
      }
    },
    "generate_openapi_yaml": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/main.py",
        "{projectRoot}/router.py",
        "{projectRoot}/models.py",
        "{projectRoot}/config.py",
        "{workspaceRoot}/etc/extract_openapi.py"
      ],
      "outputs": ["{workspaceRoot}/etc/alpha-service.yaml"],
      "options": {
        "commands": [
          "shx mkdir -p ./etc",
          "shx mkdir -p ./frontend/dist",
          "./backend/.venv/bin/python etc/extract_openapi.py > etc/alpha-service.yaml"
        ],
        "env": { "PYTHONPATH": "{projectRoot}", "ENV_FILE": ".env.dev" },
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["frontend:build", "build"],
      "options": {
        "commands": [
            "./backend/.venv/bin/python -m uvicorn backend.main:app --reload"
        ],
        "env": { "PYTHONPATH": "{projectRoot}", "ENV_FILE": ".env.dev" },
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/backend"],
      "options": {
        "command": "pytest",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./.venv/bin/ruff check --config ../etc/ruff.toml .",
        "cwd": "{projectRoot}"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./.venv/bin/python -m pip freeze > requirements.txt",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./.venv/bin/ruff format --config ../etc/ruff.toml .",
        "cwd": "{projectRoot}"
      }
    },
    "build_docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["backend:build", "frontend:build"], 
      "options": {
        "commands": [
          "docker buildx build -t alpha-app -f {projectRoot}/Dockerfile ."
        ],
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}
