{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "backend",
  "sourceRoot": "{projectRoot}",
  "targets": {
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./.venv/bin/python -m pip freeze > requirements.txt",
        "cwd": "{projectRoot}"
      }
    },
    "extract_openapi": {
      "executor": "nx:run-commands",
      "dependsOn": ["create_venv"],
      "outputs": ["{workspaceRoot}/etc/alpha-service.yaml"],
      "options": {
        "commands": [
          "./.venv/bin/python _extract_openapi.py > ../etc/alpha-service.yaml"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "create_venv": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/requirements-dev.txt",
        "{projectRoot}/requirements.txt",
        { "env": "PYTHON_VERSION" } 
      ],
      "outputs": ["{projectRoot}/.venv"],
      "options": {
        "commands": [
          "python3 -m venv .venv",
          "./.venv/bin/pip install --upgrade pip",
          "./.venv/bin/pip install -r requirements-dev.txt"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["create_venv","extract_openapi"],
      "outputs": ["{projectRoot}/__pycache__"],
      "options": {
        "command": "./.venv/bin/python -m compileall .",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "./.venv/bin/python -m uvicorn main:app --reload",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/backend"],
      "options": {
        "command": "pytest",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flake8 .",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["scope:backend", "type:app"]
}