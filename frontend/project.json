{
  "name": "frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "frontend/src",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": ["backend:generate_openapi_yaml"],
      "outputs": ["{projectRoot}/src/generated"],
      "inputs": [
        "{workspaceRoot}/etc/alpha-service.yaml", 
        "{projectRoot}/orval.config.ts"
      ],
      "options": {
        "command": "npx orval",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "description": "this runs in {workspaceRoot}, start the UI and sets up a proxy for the api endpoints",
      "executor": "@nx/vite:build",
      "dependsOn": ["generate"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "configFile": "{projectRoot}/vite.config.ts"
      }
    },
    "serve": {
      "description": "this runs in {workspaceRoot}, we need a alpha-service.yaml file to work",
      "executor": "@nx/vite:dev-server",
      "dependsOn": ["generate"],
      "options": {
        "buildTarget": "frontend:build"
      }
    }
  }
}