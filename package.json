{
  "name": "alpha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "nx run-many -t serve",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "clean": "nx clean"
  },
  "nx": {
    "targets": {
      "clean": {
        "executor": "nx:run-commands",
        "options": {
          "parallel": false,
          "commands": [
            "rimraf frontend/node_modules",
            "rimraf backend/__pycache__",
            "rimraf frontend/.venv"
          ]
        }
      }
    }
  },
  "devDependencies": {
    "@nx/docker": "22.6.1",
    "@nx/vite": "22.6.1",
    "@nx/vitest": "22.6.1",
    "@nxlv/python": "^22.1.1",
    "nx": "22.6.1",
    "rimraf": "^6.1.3",
    "vite": "^7.0.0",
    "vitest": "~4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwohlf/alpha.git"
  }
}